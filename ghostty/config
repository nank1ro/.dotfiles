# Font
font-family = JetBrains Mono
font-size = 15

# Theme
theme = Dracula+

# Window
macos-titlebar-style = tabs
window-padding-x = 4
window-padding-y = 4

# Misc
confirm-close-surface = false
shell-integration-features = no-title
mouse-scroll-multiplier = 0.5

# Keybindings: send special chars to NeoVim for CMD+ keys
# These match the <Char-0xNN> mappings in nvim/lua/config/keymaps.lua
keybind = super+s=text:\xC2\xAA
keybind = super+x=text:\xC2\xAB
keybind = super+b=text:\xC2\xAC
keybind = super+period=text:\xC2\xAD
keybind = super+o=text:\xC2\xAF
keybind = super+slash=text:\xC2\xB0
