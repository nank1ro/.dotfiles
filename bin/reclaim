#!/usr/bin/env bash
set -uo pipefail

usage() { cat <<'EOF'
reclaim — free disk by clearing regenerable dev caches & build artifacts.

Clears: npm/pnpm/yarn/pub/gradle/cargo/go/CocoaPods caches, ~/.cache,
Flutter build artifacts, Dart analyzer cache, Xcode DerivedData + DeviceSupport,
Homebrew old versions, ALL unused Docker images, ~/Library/Caches, ~/Library/Logs,
Xcode Archives, the Trash, agent-reviews ledgers in ~/github repos and ~/flutter,
OpenCode undo snapshots, Codex temp files, inactive Claude Code versions, and
T3 Code Electron caches; VACUUMs the T3 Code state DB (no data lost) when closed.
Asks before deleting linked git worktrees and orphaned Claude/T3 Code/Codex
worktree dirs (skipped with -y). Always removes Claude/T3 Code/Codex worktrees
untouched for 14+ days if clean and their commits are on a branch; warns otherwise.
Prunes AI transcripts/logs older than 14 days (Claude, Codex, OpenCode, T3).

Never touches: source code, browser profiles, SDK-matched simulator runtimes,
installed CLI binaries (~/.cargo/bin, ~/.pub-cache/bin), or JetBrains/Android
Studio Local History.

Usage:
  reclaim            confirm, then clean
  reclaim -y         skip the prompt (cron-safe)
  reclaim --deep     ALSO remove node_modules + Python .venv across ~/github
                     (regenerable, but forces reinstall in ALL projects)
EOF
}

GH="${HOME:?}/github"
YES=0; DEEP=0
for a in "$@"; do
  case "$a" in
    -y|--yes)  YES=1 ;;
    --deep)    DEEP=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $a (try --help)"; exit 1 ;;
  esac
done

# Whole APFS container (Data + system volumes), matching Finder/Stats rather than df's Data-only %.
sp()   { /usr/sbin/diskutil info / 2>/dev/null | awk -F'[()]' '
  /Container Total Space/ { t = $2 + 0 }
  /Container Free Space/  { f = $2 + 0; h = $1; sub(/.*: +/, "", h); sub(/ +$/, "", h) }
  END { if (t) printf "   -> %s free (%d%% used)\n", h, int((t - f) * 100 / t + 0.5) }'; }
have() { command -v "$1" >/dev/null 2>&1; }
step() { printf '[%s]\n' "$1"; }
# Run external tools with NO stdin, so nothing (e.g. Corepack's pnpm/yarn download
# prompt) can silently block the script waiting on an invisible confirmation.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
run() { "$@" </dev/null >/dev/null 2>&1; }

XCODE_RUNNING=0; pgrep -xq Xcode && XCODE_RUNNING=1

echo "reclaim: clears dev caches, build artifacts, Docker images, Xcode DerivedData,"
echo "         DeviceSupport, ~/Library/Caches & Logs, Xcode Archives, and Trash."
echo "         Also: .git/agent-reviews; asks per repo before deleting linked + orphaned worktrees;"
echo "         AI tool transcripts/logs older than 14 days; Dart analyzer cache; OpenCode snapshots;"
echo "         Codex temp files; inactive Claude Code versions; T3 Code caches + state DB VACUUM."
echo "         Keeps source, browsers, simulator runtimes, installed CLIs, IDE history."
[[ $DEEP == 1 ]] && echo "         --deep: also node_modules + .venv across ~/github"
echo
if [[ $XCODE_RUNNING == 1 ]]; then
  echo "!! Xcode is running — skipping DerivedData & DeviceSupport (quit Xcode to include)."; echo
fi
if [[ $YES == 0 ]]; then
  read -r -p "Proceed? [y/N] " ans || ans=""
  [[ "${ans:-}" == [yY]* ]] || { echo "Aborted."; exit 0; }
fi
echo; echo "START:"; sp; echo

# --- JavaScript / TypeScript ---
have npm  && { step "npm cache";        run npm cache clean --force; sp; }
have pnpm && { step "pnpm store prune";  run pnpm store prune;       sp; }
have yarn && { step "yarn cache clean";  run yarn cache clean;       sp; }

# --- generic user cache (whole ~/.cache; may include ML/tool caches, all regenerable) ---
step "~/.cache"; rm -rf "${HOME:?}/.cache/"* 2>/dev/null; sp

# --- Dart / Flutter ---
step "Flutter build/.dart_tool in ~/github (pubspec-guarded)"
if [[ -d "$GH" ]]; then
  while IFS= read -r p; do d=$(dirname "$p"); rm -rf "$d/build" "$d/.dart_tool" 2>/dev/null; done \
    < <(find "$GH" -maxdepth 4 -name pubspec.yaml -not -path "*/build/*" 2>/dev/null)
fi; sp
# download caches only — keep ~/.pub-cache/bin + global_packages (activated CLIs)
step "pub-cache downloads (keeps global CLIs)"
rm -rf "${HOME:?}/.pub-cache/hosted" "${HOME:?}/.pub-cache/git" 2>/dev/null; sp
step "Dart analyzer cache (~/.dartServer)"
rm -rf "${HOME:?}/.dartServer/.analysis-driver" "${HOME:?}/.dartServer/.plugin_manager" 2>/dev/null; sp

# --- iOS / macOS (CocoaPods + Xcode) ---
have pod && { step "CocoaPods cache"; run pod cache clean --all; sp; }
if [[ $XCODE_RUNNING == 0 ]]; then
  step "Xcode DerivedData"; rm -rf "${HOME:?}/Library/Developer/Xcode/DerivedData/"* 2>/dev/null; sp
  step "iOS/watchOS DeviceSupport + CoreSimulator caches (regenerate on device connect)"
  rm -rf "${HOME:?}/Library/Developer/Xcode/iOS DeviceSupport/"* \
         "${HOME:?}/Library/Developer/Xcode/watchOS DeviceSupport/"* \
         "${HOME:?}/Library/Developer/CoreSimulator/Caches/"* 2>/dev/null
  have xcrun && run xcrun simctl delete unavailable; sp
fi
# Xcode Archives (opted in — these include release-build dSYMs for crash symbolication)
step "Xcode Archives"; rm -rf "${HOME:?}/Library/Developer/Xcode/Archives/"* 2>/dev/null; sp

# --- Go / Rust ---
have go    && { step "Go build+module cache"; run go clean -cache -modcache; sp; }
have cargo && { step "Cargo registry/git cache (keeps ~/.cargo/bin & config)"
  rm -rf "${HOME:?}/.cargo/registry/cache" "${HOME:?}/.cargo/registry/src" \
         "${HOME:?}/.cargo/git/checkouts" "${HOME:?}/.cargo/git/db" 2>/dev/null; sp; }

# --- Android / Gradle ---
step "gradle caches"; rm -rf "${HOME:?}/.gradle/caches" 2>/dev/null; sp

# --- Homebrew ---
have brew && { step "brew cleanup"; run brew cleanup --prune=all; sp; }

# --- Docker / OrbStack (removes ALL unused images, not just dangling) ---
have docker && { step "docker image prune -a"; run docker image prune -a -f; sp; }

# --- system caches & logs ---
# Wipe ~/Library/Caches, but skip JetBrains/Android Studio dirs so their
# LocalHistory (per-file IDE edit history — NOT regenerable) survives.
step "~/Library/Caches (keeping IDE dirs for LocalHistory)"
find "${HOME:?}/Library/Caches" -mindepth 1 -maxdepth 1 \
     ! -name JetBrains ! -name Google ! -name 'AndroidStudio*' \
     -exec rm -rf {} + 2>/dev/null; sp
step "~/Library/Logs"; rm -rf "${HOME:?}/Library/Logs/"* 2>/dev/null; sp

# --- Trash (opted in — irreversible) ---
step "Trash"; rm -rf "${HOME:?}/.Trash/"* 2>/dev/null; sp

# --- agent review ledgers (local-only, regenerable) ---
# ~/flutter holds the snapshots of its worktrees that live in ~/github.
if [[ -d "$GH" ]]; then
  step "agent-reviews in ~/github repos and ~/flutter (.git/agent-reviews + per-worktree)"
  find "$GH" "${HOME:?}/flutter" -maxdepth 6 -type d -name agent-reviews -path '*/.git/*' -prune -exec rm -rf {} + 2>/dev/null; sp
fi

# Agent worktree dirs: Claude (<repo>/.claude/worktrees/*), T3 Code (~/.t3/worktrees/<repo>/*),
# Codex (~/.codex/worktrees/<id>/<repo>).
agent_wts() {
  local d w
  { while IFS= read -r d; do printf '%s\n' "$d"/*/; done < <(find "$GH" -maxdepth 5 -type d -path '*/.claude/worktrees' -prune 2>/dev/null)
    printf '%s\n' "$HOME"/.t3/worktrees/*/*/ "$HOME"/.codex/worktrees/*/*/; } |
  while IFS= read -r w; do w=${w%/}; [[ -d "$w" ]] && printf '%s\n' "$w"; done
}
# Prints the shared .git dir of a worktree that git still tracks; fails for orphans.
wt_common() {
  local gd; gd=$(sed -n 's/^gitdir: //p' "$1/.git" 2>/dev/null)
  [[ -n "$gd" && -d "$gd" ]] && git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

# --- stale agent worktrees (untouched 14+ days, clean, HEAD on a branch; runs with -y too) ---
step "Claude/T3 Code/Codex worktrees untouched >14d (clean, commits on a branch)"
while IFS= read -r -u 3 w; do
  common=$(wt_common "$w") || continue
  [[ -z "$(find "$w" -mtime -14 -print -quit 2>/dev/null)" ]] || continue
  [[ -z "$(git -C "$w" status --porcelain 2>/dev/null)" ]] || { echo "   !! kept (uncommitted changes, check it): $w"; continue; }
  [[ -n "$(git -C "$w" for-each-ref --count=1 --contains HEAD refs/heads refs/remotes 2>/dev/null)" ]] || { echo "   !! kept (commits on no branch, check it): $w"; continue; }
  git -C "$common" worktree remove "$w" </dev/null >/dev/null 2>&1 && echo "   removed $w"
done 3< <(agent_wts)
sp

# --- linked git worktrees (per-repo confirmation; skipped with -y) ---
if [[ $YES == 0 && -d "$GH" ]]; then
  while IFS= read -r -u 3 g; do
    [[ -n "$(ls -A "$g/worktrees" 2>/dev/null)" ]] || continue
    repo=$(dirname "$g")
    wts=$(git -C "$repo" worktree list --porcelain 2>/dev/null | awk '/^worktree /{sub(/^worktree /,""); print}' | tail -n +2)
    echo; echo "$repo has linked worktrees (checkouts are deleted, uncommitted work is lost):"
    while IFS= read -r w; do
      [[ -z "$w" ]] && continue
      dirty=""; [[ -n "$(git -C "$w" status --porcelain 2>/dev/null)" ]] && dirty=" [UNCOMMITTED CHANGES]"
      echo "   $w$dirty"
    done <<< "$wts"
    read -r -p "Delete them and .git/worktrees? [y/N] " ans || ans=""
    [[ "${ans:-}" == [yY]* ]] || continue
    ok=1
    while IFS= read -r w; do
      [[ -z "$w" ]] && continue
      git -C "$repo" worktree remove --force --force "$w" </dev/null >/dev/null 2>&1 || { echo "   !! could not remove $w"; ok=0; }
    done <<< "$wts"
    git -C "$repo" worktree prune </dev/null >/dev/null 2>&1
    [[ $ok == 1 ]] && rm -rf "$g/worktrees"
  done 3< <(find "$GH" -maxdepth 3 -type d -name .git -prune 2>/dev/null)
  sp
fi

# --- orphaned agent worktree dirs git no longer tracks (confirmation; skipped with -y) ---
if [[ $YES == 0 ]]; then
  orphans=()
  while IFS= read -r w; do wt_common "$w" >/dev/null || orphans+=("$w"); done < <(agent_wts)
  if (( ${#orphans[@]} )); then
    echo; echo "Claude/T3 Code/Codex worktree dirs git no longer tracks (contents are lost):"
    printf '   %s\n' "${orphans[@]}"
    read -r -p "Delete them? [y/N] " ans || ans=""
    [[ "${ans:-}" == [yY]* ]] && rm -rf "${orphans[@]}"
    sp
  fi
fi

# --- AI tool transcripts & logs older than 14 days (never DBs or Claude memory/) ---
step "AI transcripts/logs >14d (Claude, Codex, OpenCode, T3)"
find "${HOME:?}/.claude/projects" -type d -name '*t3code-claude-title*' -prune -exec rm -rf {} + 2>/dev/null
find "${HOME:?}/.claude/projects" -type f -name '*.jsonl' -mtime +14 -not -path '*/memory/*' -delete 2>/dev/null
find "${HOME:?}/.codex/sessions" "${HOME:?}/.local/share/opencode/log" "${HOME:?}/.t3/userdata/logs" \
     -type f -mtime +14 -delete 2>/dev/null
find "${HOME:?}/.claude/projects" "${HOME:?}/.codex/sessions" -mindepth 1 -type d -empty -delete 2>/dev/null; sp

# --- T3 Code: compact state DB (keeps all data) + Electron caches; only while T3 Code is closed ---
step "T3 Code state DB VACUUM + Electron caches"
t3db="${HOME:?}/.t3/userdata/statev2.sqlite"
if [[ ! -x /usr/sbin/lsof ]]; then
  echo "   !! /usr/sbin/lsof not found, skipped (cannot verify T3 Code is closed)"
elif pgrep -f 'T3 Code' >/dev/null || { [[ -f "$t3db" ]] && /usr/sbin/lsof -t -- "$t3db" >/dev/null 2>&1; }; then
  echo "   !! T3 Code is running, skipped (quit it to include)"
else
  [[ -f "$t3db" ]] && have sqlite3 && run sqlite3 "$t3db" 'VACUUM;'
  for a in "${HOME:?}/Library/Application Support/"{t3code,t3code-v2}; do
    rm -rf "$a/"{Cache,"Code Cache",GPUCache} "$a/Partitions/"*/{Cache,"Code Cache",GPUCache} 2>/dev/null
  done
fi; sp

# --- AI tool scratch data (undo snapshots, temp files, old binaries) ---
step "OpenCode snapshots, Codex temp files, inactive Claude Code versions"
rm -rf "${HOME:?}/.local/share/opencode/snapshot" "${HOME:?}/.codex/.tmp/"* 2>/dev/null
active_claude=$(readlink "${HOME:?}/.local/bin/claude" 2>/dev/null)
if [[ -n "$active_claude" ]]; then
  for v in "${HOME:?}/.local/share/claude/versions/"*; do
    [[ -e "$v" && "$v" != "$active_claude" ]] && rm -rf "$v"
  done
fi
sp

# --- deep (opt-in): project dependencies ---
if [[ $DEEP == 1 && -d "$GH" ]]; then
  step "node_modules across ~/github (--deep)"
  find "$GH" -type d -name node_modules -prune -exec rm -rf {} + 2>/dev/null; sp
  step "Python .venv across ~/github (--deep)"
  find "$GH" -type d -name .venv -prune -exec rm -rf {} + 2>/dev/null; sp
fi

echo; echo "DONE."; sp
