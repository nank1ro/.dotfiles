#!/usr/bin/env bash
set -uo pipefail

usage() { cat <<'EOF'
reclaim — free disk by clearing regenerable dev caches & build artifacts.

Clears: npm/pnpm/yarn/bun/pub/gradle/cargo/go/CocoaPods/conda/NuGet/Hex/Cabal/
Ivy caches, Ruby .gem archives, nvm/pyenv/rbenv/asdf downloads, ~/.cache, Flutter
build artifacts, Dart analyzer cache, Xcode DerivedData + DeviceSupport + Archives,
Homebrew old versions, unused Docker images/containers/build cache (keeps volumes),
~/Library/Caches + Logs, VS Code/Cursor/Windsurf, Slack and Discord caches (when
closed), Raycast update downloads, Zed's npm cache, Mail
downloads, broken preference files, the Trash (incl. external drives),
agent-reviews ledgers, OpenCode snapshots, Codex temp files, inactive Claude Code
versions, T3 Code caches + state DB VACUUM (no data lost, when closed), and AI
transcripts/logs older than 14 days. With your admin password (asked once): the
system icon + symbol caches, /Library/Logs and rotated /var/log files.
Always removes Claude/T3 Code/Codex worktrees untouched for 14+ days if clean
and their commits are on a branch.

Asks to open System Settings when Full Disk Access is missing for Mail downloads
and iOS backups ("Don't ask again" is stored in ~/.local/state/reclaim).

Checklists (interactive terminal only): linked git worktrees (uncommitted ones
unticked), stale worktrees kept for safety, orphaned worktree dirs, login items
whose program is gone, and opt-in real data (iOS backups, deleted users' homes).

Never touches: source code, browser profiles, SDK-matched simulator runtimes,
installed CLI binaries (~/.cargo/bin, ~/.pub-cache/bin), or JetBrains/Android
Studio Local History.

Shows live progress with gum (charm.land), installed via Homebrew (or a verified release download)
on first run; falls back to plain text when gum is unavailable or output is piped.

Usage:
  reclaim            confirm, then clean
  reclaim -y         skip the Proceed prompt (checklists still appear)
  reclaim --deep     ALSO remove node_modules, Python .venv and Rust target/ across ~/github
                     (regenerable, but forces reinstall in ALL projects)
EOF
}

GH="${HOME:?}/github"
YES=0; DEEP=0
for a in "$@"; do
  case "$a" in
    -y|--yes)  YES=1 ;;
    --deep)    DEEP=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $a (try --help)"; exit 1 ;;
  esac
done

have() { command -v "$1" >/dev/null 2>&1; }
# Run external tools with NO stdin, so nothing (e.g. Corepack's pnpm/yarn download
# prompt) can silently block the script waiting on an invisible confirmation.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
run() { "$@" </dev/null >/dev/null 2>&1; }

gb() { awk -v b="$1" 'BEGIN { printf "%.1f GB", (b > 0 ? b : 0) / 1e9 }'; }
# Whole APFS container (Data + system volumes), matching Finder/Stats rather than df's Data-only %:
# df's size and avail for the Data volume are the container's total and free space.
# Sets TOTAL and FREE (bytes), FREE_H (e.g. "86.6 GB") and FREE_PCT.
disk() {
  read -r TOTAL FREE < <(df -k /System/Volumes/Data | awk 'NR == 2 { printf "%.0f %.0f\n", $2 * 1024, $4 * 1024 }')
  FREE_H=$(gb "$FREE"); FREE_PCT=$(( ${TOTAL:-0} ? (FREE * 100 + TOTAL / 2) / TOTAL : 0 ))
}
usage_line() { echo "$FREE_H free ($FREE_PCT% free, $((100 - FREE_PCT))% used)"; }

# Live progress via gum (charm.land): install it on first run, else fall back to plain text.
# Without brew, fetch the checksum-verified release binary into ~/.local/bin (stock macOS tools only).
gum_fetch() {
  local base=https://github.com/charmbracelet/gum/releases tag ver arch tmp asset
  tag=$(curl -fsSIL -o /dev/null -w '%{url_effective}' "$base/latest") || return 1; tag=${tag##*/}; ver=${tag#v}
  case $(uname -m) in arm64) arch=arm64 ;; x86_64) arch=x86_64 ;; *) return 1 ;; esac
  asset=gum_${ver}_Darwin_$arch.tar.gz; tmp=$(mktemp -d) || return 1
  { curl -fsSL -o "$tmp/$asset" "$base/download/$tag/$asset" && curl -fsSL -o "$tmp/sums" "$base/download/$tag/checksums.txt" &&
    [[ $(shasum -a 256 "$tmp/$asset" | awk '{print $1}') == "$(awk -v f="$asset" '$2 == f {print $1}' "$tmp/sums")" ]] &&
    tar -xzf "$tmp/$asset" -C "$tmp" "${asset%.tar.gz}/gum" && mkdir -p "$HOME/.local/bin" &&
    install -m 755 "$tmp/${asset%.tar.gz}/gum" "$HOME/.local/bin/gum"; } 2>/dev/null
  local rc=$?; rm -rf "$tmp"; return $rc
}
if ! have gum; then
  echo "reclaim: installing gum for live progress (one-time)..."
  if have brew; then run brew install gum; else gum_fetch </dev/null >/dev/null 2>&1 || true; fi
  case :$PATH: in *":$HOME/.local/bin:"*) ;; *) PATH="$PATH:$HOME/.local/bin" ;; esac
fi
UI=0; [[ -t 1 ]] && have gum && UI=1

# step NAME starts a step (spinner in UI mode); sp ends it and reports the space it freed.
STEP=""; SPIN=""; pids=(); SUDO_KEEP=""
# Spinner is a bash loop, not `gum spin`: gum can miss a kill that lands during its startup and hang wait.
spin_start() {
  [[ $UI == 1 ]] || return 0
  local cols; cols=$(stty size </dev/tty 2>/dev/null | awk '{ print $2 }')
  [ "${cols:-0}" -gt 0 ] 2>/dev/null || cols=80  # empty/0/non-numeric = unknown
  local t=${STEP:0:$(( cols > 3 ? cols - 3 : 0 ))}  # never wrap: \r only redraws one line
  printf '\033[?25l'
  { while :; do for f in ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏; do printf '\r\033[36m%s\033[0m %s\033[K' "$f" "$t"; sleep 0.1; done; done; } &
  SPIN=$!
}
spin_stop() {
  [[ -n $SPIN ]] || return 0
  kill -KILL "$SPIN" 2>/dev/null; wait "$SPIN" 2>/dev/null; SPIN=""
  printf '\r\033[K\033[?25h'  # clear spinner line, show cursor
}
note() { spin_stop; echo "   $*"; spin_start; }
step() {
  sp; STEP=$1; STEP_T=$SECONDS; disk; STEP_FREE=$FREE
  if [[ $UI == 1 ]]; then spin_start; else printf '[%s]\n' "$1"; fi
}
# UI: green line when the step freed >= 0.05 GB, dimmed otherwise; duration shown when >= 1s.
sp() {
  [[ -n $STEP ]] || return 0
  spin_stop; disk
  local freed=$((FREE - STEP_FREE)) dt=$((SECONDS - STEP_T)) tm=""
  (( dt >= 1 )) && tm=" ${dt}s"
  if [[ $UI == 0 ]]; then printf '   -> freed %s%s, %s\n' "$(gb $freed)" "$tm" "$(usage_line)"
  elif (( freed >= 50000000 )); then printf '\033[32m✓ %8s\033[0m  %s\033[2m%s\033[0m\n' "$(gb $freed)" "$STEP" "$tm"
  else printf '\033[2m· %8s  %s%s\033[0m\n' "$(gb $freed)" "$STEP" "$tm"; fi
  STEP=""
}
ASK=0; [[ -t 0 ]] && ASK=1  # checklists and questions need an interactive terminal
confirm() {
  if [[ $UI == 1 ]]; then gum confirm --default=false "$1" </dev/tty
  else local a; read -r -p "$1 [y/N] " a </dev/tty || a=""; [[ $a == [yY]* ]]; fi
}
short() { case $1 in "$HOME"/*) printf '%s\n' "~${1#"$HOME"}" ;; *) printf '%s\n' "$1" ;; esac; }
# pick HEADER SELECTED ITEM...: prints the chosen items, one per line. Items are "path │ details",
# shown with ~ for $HOME. UI: gum multi-select, SELECTED is a comma list of items or "*";
# plain: one y/N for all.
pick() {
  local header=$1 sel=$2 i l items=() s=(); shift 2
  for i in "$@"; do items+=("$(short "$i")"); done
  if [[ $sel != "*" && -n $sel ]]; then
    IFS=, read -r -a s <<< "$sel"; sel=""; for i in "${s[@]}"; do sel+="${sel:+,}$(short "$i")"; done
  fi
  if [[ $UI == 1 ]]; then gum choose --no-limit --height 15 --header "$header" --selected "$sel" "${items[@]}" </dev/tty || true
  else { echo; echo "$header"; printf '   %s\n' "${items[@]}"; } >&2; confirm "Delete them?" && printf '%s\n' "${items[@]}"; fi |
  while IFS= read -r l; do [[ $l == "~/"* ]] && l="$HOME${l#\~}"; printf '%s\n' "$l"; done
}
on_int() {
  spin_stop; echo; echo "Interrupted."
  [[ -z $SUDO_KEEP ]] || kill "$SUDO_KEEP" 2>/dev/null
  kill -TERM ${pids[@]+"${pids[@]}"} 2>/dev/null; wait ${pids[@]+"${pids[@]}"} 2>/dev/null; exit 130
}
trap 'spin_stop; [[ -z $SUDO_KEEP ]] || kill "$SUDO_KEEP" 2>/dev/null' EXIT
trap on_int INT TERM

XCODE_RUNNING=0; pgrep -xq Xcode && XCODE_RUNNING=1

disk; START_FREE=$FREE
banner=("reclaim · $(usage_line)" ""
  "Clears dev + language caches, build artifacts, unused Docker data (not volumes),"
  "Xcode DerivedData/DeviceSupport/Archives, ~/Library/Caches & Logs, editor + app caches,"
  "Mail downloads, broken prefs, Trash, AI tool logs >14d, T3 Code caches + DB VACUUM."
  "Optional (admin password): system icon/symbol caches and system logs."
  "Checklists: worktrees, broken login items, opt-in iOS backups / deleted users."
  "Keeps source, browsers, simulator runtimes, installed CLIs/toolchains, IDE history.")
[[ $DEEP == 1 ]] && banner+=("--deep: also node_modules, .venv and Rust target/ across ~/github")
[[ $XCODE_RUNNING == 1 ]] && banner+=("" "!! Xcode is running, skipping DerivedData & DeviceSupport (quit Xcode to include).")
if [[ $UI == 1 ]]; then gum style --border rounded --border-foreground 8 --padding "0 1" "${banner[@]}"
else printf '%s\n' "${banner[@]}"; fi
if [[ $YES == 0 ]]; then
  confirm "Proceed?" || { echo "Aborted."; exit 0; }
fi
START_T=$SECONDS
disk; START_FREE=$FREE

# --- system caches & logs (root-owned): one admin prompt up front; skipped if declined ---
SUDO=0
if [[ $ASK == 1 ]] && confirm "Also clean system caches & logs? (asks for your admin password)"; then
  trap ':' INT; sudo -v </dev/tty && SUDO=1; trap on_int INT  # Ctrl-C here only skips this part
fi
if [[ $SUDO == 1 ]]; then
  { while sudo -n -v 2>/dev/null; do sleep 50; done; } </dev/null >/dev/null 2>&1 &
  SUDO_KEEP=$!
fi

# --- Full Disk Access: Mail downloads + iOS backups are privacy-protected; offer to open the settings pane ---
FDA_SKIP="${HOME:?}/.local/state/reclaim/skip-fda-prompt"
fda_missing() {
  local d
  for d in "${HOME:?}/Library/Containers/com.apple.mail/Data/Library/Mail Downloads" \
           "${HOME:?}/Library/Application Support/MobileSync/Backup"; do
    [[ -d "$d" ]] && ! /bin/ls "$d" >/dev/null 2>&1 && return 0
  done
  return 1
}
if [[ $ASK == 1 && ! -e "$FDA_SKIP" ]] && fda_missing; then
  case ${TERM_PROGRAM:-} in
    ghostty) term=Ghostty ;; Apple_Terminal) term=Terminal ;; iTerm.app) term=iTerm ;; vscode) term="VS Code" ;;
    *) term="your terminal app" ;;
  esac
  msg="Mail downloads and iOS backups need Full Disk Access for $term."
  if [[ $UI == 1 ]]; then
    ans=$(gum choose --header "$msg" "Open System Settings" "Not now" "Don't ask again" </dev/tty) || ans="Not now"
  else
    echo "$msg"
    read -r -p "[o]pen System Settings, [n]ot now, [d]on't ask again? " a </dev/tty || a=""
    case $a in
      [oO]*) ans="Open System Settings" ;;
      [dD]*) ans="Don't ask again" ;;
      *) ans="Not now" ;;
    esac
  fi
  case $ans in
    "Open System Settings")
      open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"
      echo "   Turn on $term there and restart it; this run skips those folders." ;;
    "Don't ask again") mkdir -p "${FDA_SKIP%/*}" && touch "$FDA_SKIP" ;;
  esac
fi
echo
if [[ $SUDO == 1 ]]; then
  step "System caches & logs (icon + symbol caches, /Library/Logs, rotated /var/log)"
  sudo -n sh -c 'rm -rf /Library/Caches/com.apple.iconservices.store /System/Library/Caches/com.apple.coresymbolicationd/*' 2>/dev/null
  # The daemons keep the deleted files open; restart them so the space is released (icons rebuild on demand).
  for d in com.apple.iconservices.iconservicesd com.apple.coresymbolicationd; do
    sudo -n launchctl kickstart -k "system/$d" 2>/dev/null || note "!! could not restart $d; its space returns after a reboot"
  done
  sudo -n find /Library/Logs -type f -delete 2>/dev/null
  sudo -n find /private/var/log -type f \( -name '*.gz' -o -name '*.bz2' -o -name '*.[0-9]' \) -delete 2>/dev/null
  sp
fi

# --- package managers: independent and slow to start (brew ~8s, pnpm ~4s), so run concurrently ---
par() { "$@" </dev/null >/dev/null 2>&1 & pids+=($!); }
# yarn v1, CocoaPods and the Go build cache live in ~/Library/Caches, which a later step wipes.
step "Package caches: npm, pnpm, Go modules, conda, Homebrew, Docker"
have npm    && par npm cache clean --force
have pnpm   && par pnpm store prune
have go     && par go clean -modcache  # module files are read-only, so rm alone can't remove them
have conda  && par conda clean -a -y
have brew   && par brew cleanup --prune=all
# Docker: stopped containers, unused networks, ALL unused images, build cache; keeps volumes.
# Skipped when OrbStack is installed but not running (any docker command would boot its VM).
if have docker && ! { [[ -d /Applications/OrbStack.app ]] && ! pgrep -xq OrbStack; }; then
  par docker system prune -a -f
fi
(( ${#pids[@]} )) && wait "${pids[@]}"
pids=()
sp

# --- generic user cache (whole ~/.cache; may include ML/tool caches, all regenerable) ---
step "~/.cache"; rm -rf "${HOME:?}/.cache/"* 2>/dev/null; sp

# --- other language/toolchain download caches (installed toolchains and gems are kept) ---
step "Language caches: Bun, Yarn Berry, Gradle wrappers, Ivy, NuGet, Hex, Cabal, Ruby .gem, version-manager downloads"
rm -rf "${HOME:?}/.bun/install/cache" "${HOME:?}/.yarn/berry/cache" \
       "${HOME:?}/.gradle/wrapper/dists" "${HOME:?}/.ivy2/cache" "${HOME:?}/.nuget/packages" \
       "${HOME:?}/.hex/packages" "${HOME:?}/.cabal/packages" "${HOME:?}/.android/cache" \
       "${HOME:?}/.nvm/.cache" "${HOME:?}/.pyenv/cache" "${HOME:?}/.rbenv/cache" "${HOME:?}/.asdf/downloads" \
       "${HOME:?}/.gem/ruby/"*/cache "${HOME:?}/.rbenv/versions/"*/lib/ruby/gems/*/cache \
       "${HOME:?}/.local/share/mise/installs/ruby/"*/lib/ruby/gems/*/cache 2>/dev/null; sp

# --- Dart / Flutter ---
step "Flutter build/.dart_tool in ~/github (pubspec-guarded)"
if [[ -d "$GH" ]]; then
  while IFS= read -r p; do d=$(dirname "$p"); rm -rf "$d/build" "$d/.dart_tool" 2>/dev/null; done \
    < <(find "$GH" -maxdepth 4 -name pubspec.yaml -not -path "*/build/*" 2>/dev/null)
fi; sp
# download caches only — keep ~/.pub-cache/bin + global_packages (activated CLIs)
step "pub-cache downloads (keeps global CLIs)"
rm -rf "${HOME:?}/.pub-cache/hosted" "${HOME:?}/.pub-cache/git" 2>/dev/null; sp
step "Dart analyzer cache (~/.dartServer)"
rm -rf "${HOME:?}/.dartServer/.analysis-driver" "${HOME:?}/.dartServer/.plugin_manager" 2>/dev/null; sp

# --- iOS / macOS (Xcode) ---
if [[ $XCODE_RUNNING == 0 ]]; then
  step "Xcode DerivedData"; rm -rf "${HOME:?}/Library/Developer/Xcode/DerivedData/"* 2>/dev/null; sp
  step "iOS/watchOS DeviceSupport + CoreSimulator caches (regenerate on device connect)"
  rm -rf "${HOME:?}/Library/Developer/Xcode/iOS DeviceSupport/"* \
         "${HOME:?}/Library/Developer/Xcode/watchOS DeviceSupport/"* \
         "${HOME:?}/Library/Developer/CoreSimulator/Caches/"* 2>/dev/null
  have xcrun && run xcrun simctl delete unavailable; sp
fi
# Xcode Archives (opted in — these include release-build dSYMs for crash symbolication)
step "Xcode Archives"; rm -rf "${HOME:?}/Library/Developer/Xcode/Archives/"* 2>/dev/null; sp

# --- Rust ---
have cargo && { step "Cargo registry/git cache (keeps ~/.cargo/bin & config)"
  rm -rf "${HOME:?}/.cargo/registry/cache" "${HOME:?}/.cargo/registry/src" "${HOME:?}/.cargo/registry/index" \
         "${HOME:?}/.cargo/git/checkouts" "${HOME:?}/.cargo/git/db" 2>/dev/null; sp; }

# --- Android / Gradle ---
step "gradle caches"; rm -rf "${HOME:?}/.gradle/caches" 2>/dev/null; sp

# --- system caches & logs ---
# Wipe ~/Library/Caches, but skip JetBrains/Android Studio dirs so their
# LocalHistory (per-file IDE edit history — NOT regenerable) survives.
step "~/Library/Caches (keeping IDE dirs for LocalHistory)"
find "${HOME:?}/Library/Caches" -mindepth 1 -maxdepth 1 \
     ! -name JetBrains ! -name Google ! -name 'AndroidStudio*' \
     -exec rm -rf {} + 2>/dev/null; sp
step "~/Library/Logs"; rm -rf "${HOME:?}/Library/Logs/"* 2>/dev/null; sp

# --- VS Code-family editors: Electron caches, logs, cached extension installers (only while closed) ---
step "Editor caches: VS Code, Cursor, Windsurf"
for e in "Code:Visual Studio Code" "Cursor:Cursor" "Windsurf:Windsurf"; do
  d="${HOME:?}/Library/Application Support/${e%%:*}"; [[ -d "$d" ]] || continue
  if pgrep -f "${e#*:}[^/]*\.app/" >/dev/null; then note "!! ${e#*:} is running, skipped (quit it to include)"; continue; fi
  rm -rf "$d/"{Cache,CachedData,CachedExtensionVSIXs,"Code Cache",GPUCache,logs} 2>/dev/null
done; sp

# --- app caches and downloaded updates in Application Support ---
AS="${HOME:?}/Library/Application Support"
app_closed() { ! pgrep -f "$1[^/]*\.app/" >/dev/null || { note "!! $1 is running, skipped (quit it to include)"; return 1; }; }
step "App caches: Slack, Discord old versions + updates, Raycast updates, Zed npm cache"
[[ -d "$AS/Slack" ]] && app_closed Slack && rm -rf "$AS/Slack/Service Worker" "$AS/Slack/logs" 2>/dev/null
if [[ -d "$AS/discord" ]] && app_closed Discord; then  # keep the newest app-* version
  rm -rf "$AS/discord/download" 2>/dev/null
  ls -d "$AS/discord/"app-* 2>/dev/null | sort -V | sed '$d' | while IFS= read -r v; do rm -rf "$v"; done
fi
rm -rf "$AS/com.raycast.macos/Updates/"* "$AS/Zed/node/cache" 2>/dev/null  # update downloads, npm cache
sp

# Copies Mail saved when attachments were opened; originals stay in Mail. Needs Full Disk Access.
step "Mail downloads"
rm -rf "${HOME:?}/Library/Containers/com.apple.mail/Data/Library/Mail Downloads/"* 2>/dev/null; sp

# Preference files plutil cannot parse are corrupt; apps recreate them with defaults.
step "Broken preference files"
prefs=("${HOME:?}/Library/Preferences/"*.plist "${HOME:?}/Library/Preferences/ByHost/"*.plist)
plutil -lint "${prefs[@]}" 2>&1 >/dev/null | while IFS= read -r l; do  # failures go to stderr as "path: (why)"
  f=${l%%: (*}; [[ -f "$f" ]] && rm -f "$f"
done; sp

# --- Trash (opted in — irreversible), incl. this user's trash on external drives ---
step "Trash"; find "${HOME:?}/.Trash" /Volumes/*/.Trashes/"$(id -u)" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null; sp

# Git dirs of repos in ~/github (1-2 levels deep, incl. dot-dirs) and ~/flutter: globs, not a full-tree find.
repos=()
shopt -s dotglob
for g in "$GH"/*/.git "$GH"/*/*/.git "${HOME:?}/flutter/.git"; do [[ -d "$g" ]] && repos+=("$g"); done
shopt -u dotglob

# --- agent review ledgers (local-only, regenerable) ---
# ~/flutter holds the snapshots of its worktrees that live in ~/github.
step "agent-reviews in ~/github repos and ~/flutter (.git/agent-reviews + per-worktree)"
for g in ${repos[@]+"${repos[@]}"}; do rm -rf "$g/agent-reviews" "$g/worktrees/"*/agent-reviews 2>/dev/null; done; sp

# Agent worktree dirs: Claude (<repo>/.claude/worktrees/*), T3 Code (~/.t3/worktrees/<repo>/*),
# Codex (~/.codex/worktrees/<id>/<repo>).
agent_wts() {
  local g w
  { for g in ${repos[@]+"${repos[@]}"}; do printf '%s\n' "${g%/.git}/.claude/worktrees/"*/; done
    printf '%s\n' "$HOME"/.t3/worktrees/*/*/ "$HOME"/.codex/worktrees/*/*/; } |
  while IFS= read -r w; do w=${w%/}; [[ -d "$w" ]] && printf '%s\n' "$w"; done
}
# Prints the shared .git dir of a worktree that git still tracks; fails for orphans.
wt_common() {
  local gd; gd=$(sed -n 's/^gitdir: //p' "$1/.git" 2>/dev/null)
  [[ -n "$gd" && -d "$gd" ]] && git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

# --- stale agent worktrees (untouched 14+ days, clean, HEAD on a branch; runs with -y too) ---
step "Claude/T3 Code/Codex worktrees untouched >14d (clean, commits on a branch)"
kept=()
while IFS= read -r -u 3 w; do
  common=$(wt_common "$w") || continue
  [[ -z "$(find "$w" -mtime -14 -print -quit 2>/dev/null)" ]] || continue
  st=$(git -C "$w" status --porcelain 2>/dev/null) || { note "!! kept (git status failed): $w"; kept+=("$w │ git status failed"); continue; }
  [[ -z "$st" ]] || { note "!! kept (uncommitted changes): $w"; kept+=("$w │ uncommitted changes"); continue; }
  [[ -n "$(git -C "$w" for-each-ref --count=1 --contains HEAD refs/heads refs/remotes 2>/dev/null)" ]] || { note "!! kept (commits on no branch): $w"; kept+=("$w │ commits on no branch"); continue; }
  git -C "$common" worktree remove "$w" </dev/null >/dev/null 2>&1 && note "removed $w"
done 3< <(agent_wts)
sp
if [[ $ASK == 1 ]] && (( ${#kept[@]} )); then
  while IFS= read -r l; do
    [[ -n "$l" ]] || continue; w=${l%% │*}
    { common=$(wt_common "$w") && git -C "$common" worktree remove --force --force "$w" </dev/null >/dev/null 2>&1; } || echo "   !! could not remove $w"
  done < <(pick "Stale worktrees kept for safety: tick any to delete anyway (their work is lost)" "" "${kept[@]}")
fi

# --- linked git worktrees of all repos: one checklist; only clean ones with commits on a branch preselected ---
if [[ $ASK == 1 ]]; then
  labels=(); sel=""
  for g in ${repos[@]+"${repos[@]}"}; do
    [[ -n "$(ls -A "$g/worktrees" 2>/dev/null)" ]] || continue
    while IFS= read -r w; do
      [[ -n "$w" && -d "$w" ]] || continue
      b=$(git -C "$w" branch --show-current 2>/dev/null)
      l="$w │ ${b:-detached} · last commit $(git -C "$w" log -1 --format=%cs 2>/dev/null)"
      if ! st=$(git -C "$w" status --porcelain 2>/dev/null); then l+=" · ⚠ STATUS UNKNOWN"
      elif [[ -n "$st" ]]; then l+=" · ⚠ UNCOMMITTED CHANGES"
      elif [[ -z "$(git -C "$w" for-each-ref --count=1 --contains HEAD refs/heads refs/remotes 2>/dev/null)" ]]; then l+=" · ⚠ COMMITS ON NO BRANCH"
      else sel+="${sel:+,}$l"; fi
      labels+=("$l")
    done < <(git -C "${g%/.git}" worktree list --porcelain 2>/dev/null | awk '/^worktree /{sub(/^worktree /,""); print}' | tail -n +2)
  done
  if (( ${#labels[@]} )); then
    while IFS= read -r l; do
      [[ -n "$l" ]] || continue; w=${l%% │*}
      { common=$(wt_common "$w") && git -C "$common" worktree remove --force --force "$w" </dev/null >/dev/null 2>&1; } || echo "   !! could not remove $w"
    done < <(pick "Linked worktrees to delete (space toggles, enter confirms)" "$sel" "${labels[@]}")
    for g in "${repos[@]}"; do git -C "${g%/.git}" worktree prune </dev/null >/dev/null 2>&1; done
  fi
fi

# --- orphaned agent worktree dirs git no longer tracks: checklist, all preselected ---
if [[ $ASK == 1 ]]; then
  orphans=()
  while IFS= read -r w; do wt_common "$w" >/dev/null || orphans+=("$w"); done < <(agent_wts)
  if (( ${#orphans[@]} )); then
    while IFS= read -r w; do [[ -n "$w" ]] && rm -rf "$w"; done \
      < <(pick "Worktree dirs git no longer tracks (contents are lost): untick any to keep" "*" "${orphans[@]}")
  fi
fi

# --- login items (LaunchAgents) whose program no longer exists: checklist, all preselected ---
if [[ $ASK == 1 ]]; then
  broken=()
  for f in "${HOME:?}/Library/LaunchAgents/"*.plist; do
    [[ -f "$f" ]] || continue
    prog=$(plutil -extract Program raw -o - "$f" 2>/dev/null || plutil -extract ProgramArguments.0 raw -o - "$f" 2>/dev/null)
    [[ $prog == /* && ! -e $prog ]] && broken+=("$f │ missing $prog")
  done
  if (( ${#broken[@]} )); then
    while IFS= read -r l; do
      [[ -n "$l" ]] || continue; f=${l%% │*}
      launchctl bootout "gui/$(id -u)" "$f" 2>/dev/null; rm -f "$f"
    done < <(pick "Login items whose program is gone: untick any to keep" "*" "${broken[@]}")
  fi
fi

# --- AI tool transcripts & logs older than 14 days (never DBs or Claude memory/) ---
step "AI transcripts/logs >14d (Claude, Codex, OpenCode), T3 Code diagnostic logs >3d"
find "${HOME:?}/.claude/projects" -type d -name '*t3code-claude-title*' -prune -exec rm -rf {} + 2>/dev/null
find "${HOME:?}/.claude/projects" -type f \( -name '*.jsonl' -o -path '*/tool-results/*' \) -mtime +14 \
     -not -path '*/memory/*' -delete 2>/dev/null
find "${HOME:?}/.codex/sessions" "${HOME:?}/.local/share/opencode/log" -type f -mtime +14 -delete 2>/dev/null
find "${HOME:?}/.t3/userdata/logs" -type f -mtime +3 -delete 2>/dev/null  # diagnostics, not transcripts
find "${HOME:?}/.claude/projects" "${HOME:?}/.codex/sessions" -mindepth 1 -type d -empty -delete 2>/dev/null; sp

# --- T3 Code: compact state DB (keeps all data) + Electron caches; only while T3 Code is closed ---
step "T3 Code state DB VACUUM + Electron caches"
t3db="${HOME:?}/.t3/userdata/statev2.sqlite"
if [[ ! -x /usr/sbin/lsof ]]; then
  note "!! /usr/sbin/lsof not found, skipped (cannot verify T3 Code is closed)"
elif pgrep -f 'T3 Code[^/]*\.app/' >/dev/null || { [[ -f "$t3db" ]] && /usr/sbin/lsof -t -- "$t3db" >/dev/null 2>&1; }; then
  note "!! T3 Code is running, skipped (quit it to include)"
else
  if [[ -f "$t3db" ]] && have sqlite3; then  # VACUUM rewrites the whole DB (~14s), so only when >= 100 MB is free
    { read -r fl; read -r ps; } < <(sqlite3 "$t3db" 'PRAGMA freelist_count; PRAGMA page_size;' 2>/dev/null)
    (( ${fl:-0} * ${ps:-0} >= 100000000 )) && run sqlite3 "$t3db" 'VACUUM;'
  fi
  for a in "${HOME:?}/Library/Application Support/"{t3code,t3code-v2}; do
    rm -rf "$a/"{Cache,"Code Cache",GPUCache} "$a/Partitions/"*/{Cache,"Code Cache",GPUCache} 2>/dev/null
  done
fi; sp

# --- AI tool scratch data (undo snapshots, temp files, old binaries) ---
step "OpenCode snapshots, Codex temp files, inactive Claude Code versions"
rm -rf "${HOME:?}/.local/share/opencode/snapshot" "${HOME:?}/.codex/.tmp/"* 2>/dev/null
active_claude=$(readlink "${HOME:?}/.local/bin/claude" 2>/dev/null)
if [[ -n "$active_claude" ]]; then
  for v in "${HOME:?}/.local/share/claude/versions/"*; do
    [[ -e "$v" && "$v" != "$active_claude" ]] && rm -rf "$v"
  done
fi
sp

# --- real data, opt-in only (nothing preselected): iOS device backups, deleted users' archived homes ---
if [[ $ASK == 1 ]]; then
  data=(); STEP="Looking for iOS backups and deleted users"; spin_start  # du on big backups takes a while
  for b in "${HOME:?}/Library/Application Support/MobileSync/Backup/"*/; do  # needs Full Disk Access
    [[ -d "$b" ]] || continue; b=${b%/}
    n=$(plutil -extract "Device Name" raw -o - "$b/Info.plist" 2>/dev/null)
    data+=("$b │ iOS backup of ${n:-unknown device}, $(stat -f %Sm -t %Y-%m-%d "$b"), $(du -sh "$b" 2>/dev/null | cut -f1)")
  done
  if [[ $SUDO == 1 ]]; then
    while IFS= read -r u; do data+=("/Users/Deleted Users/$u │ archived home of a deleted user"); done \
      < <(sudo -n ls "/Users/Deleted Users" 2>/dev/null)
  fi
  spin_stop; STEP=""
  if (( ${#data[@]} )); then
    while IFS= read -r l; do
      [[ -n "$l" ]] || continue; f=${l%% │*}
      if [[ $f == "/Users/Deleted Users/"* ]]; then sudo -n rm -rf "$f"; else rm -rf "$f"; fi
    done < <(pick "Real data, not cache: tick only what you want deleted for good" "" "${data[@]}")
  fi
fi

# --- deep (opt-in): project dependencies and build outputs ---
if [[ $DEEP == 1 && -d "$GH" ]]; then
  step "--deep: node_modules, Python .venv, Rust target/ (next to Cargo.toml) across ~/github"
  while IFS= read -r p; do  # one pass; pruned dirs are not descended into
    case $p in
      */Cargo.toml) rm -rf "${p%/Cargo.toml}/target" ;;
      */node_modules|*/.venv) rm -rf "$p" ;;
    esac
  done < <(find "$GH" \( -name node_modules -o -name .venv -o -name target -o -name .git \) -type d -prune -print \
             -o -name Cargo.toml -print 2>/dev/null)
  sp
fi

sp; disk
done_msg="Freed $(gb $((FREE - START_FREE))) in $((SECONDS - START_T))s · now $(usage_line)"
echo
if [[ $UI == 1 ]]; then gum style --border rounded --border-foreground 2 --padding "0 1" --bold "$done_msg"
else echo "DONE: $done_msg"; fi
